# Copy to `.env` (ignored by git) and fill in. Real environment variables win.

# Where Grafeno comes from: included (the agent's own Grafeno: it installs
# and runs it on 127.0.0.1:7811, with its own data, apart from any Grafeno
# you have) or external (a Grafeno server at GRAFENO_URL, such as the one on
# this computer). Empty: the agent asks on its first run, saying whether it
# found a Grafeno on this computer.
GRAFENO_MODE=

# The Grafeno server, when external.
GRAFENO_URL=http://127.0.0.1:7810

# The agent's own key, made by an administrator with `grafeno keys create`.
# Never commit it.
GRAFENO_AGENT_KEY=

# The namespace the agent keeps its memory in.
GRAFENO_NAMESPACE=grafeno-agent

# The model the agent reasons with. `claude-code` drives the locally
# logged-in Claude Code (the user's subscription, no API key).
AGENT_MODEL=claude-code

# For claude-code: the Claude model (haiku, sonnet, opus...). Empty: Claude
# Code's own default. It spends the same plan either way; lighter models
# spend less of it.
CLAUDE_MODEL=

# For claude-code: the effort (low, medium, high, xhigh, max). Empty: the
# model's own.
AGENT_EFFORT=

# The project the agent works on: its memory lives in a palace of this name.
# Empty: the git repository (or folder) the agent runs in.
AGENT_PROJECT=

# Whose palace the project's memory goes in: shared (the project's own, used
# by every agent on it) or own (a palace of this agent alone, named
# "<project> · <agent>", for an agent that does not work with the others).
AGENT_PALACE=shared

# Meaning for memory: e5-small (a local model, downloaded once, about 130 MB,
# into ~/.cache/grafeno-agent/models) or none (words alone).
AGENT_EMBEDDER=e5-small

# The shell that runs commands: the program and its arguments. Empty: Git's
# bash on Windows when installed, else cmd; /bin/sh elsewhere.
AGENT_SHELL=

# The providers the agent may reason with: auto (the default) uses the ones
# Auto includes (below) that are installed and signed in; or a list in order of
# preference (claude-code, codex, gemini, openrouter), where the chat uses the
# first. A run gives each task to one with room, and moves it to another when one
# hits its plan's limit. Claude and Codex use their own official CLI and your
# subscription; Gemini and OpenRouter use your own API key (grafeno-agent login
# gemini, grafeno-agent login openrouter).
AGENT_PROVIDERS=auto

# The providers Auto includes, separated by commas (/connect, space, changes it).
# Empty: none yet; Auto warns until you choose. A provider reached with an API
# key may bill per token: include it only if you mean it.
AGENT_AUTO_PROVIDERS=

# The tier of your Gemini key, as you declare it (set by login gemini): free
# (no billing on its project) or paid. Paid or undeclared bills by consumption.
GEMINI_TIER=

# OpenRouter's models the agent may use (set by login openrouter): free (the
# default: only free models, never billed) or all (paid ones too, billed per
# token, only with AGENT_ALLOW_BILLING=openrouter).
OPENROUTER_MODELS=

# Providers you allow to bill by consumption (claude-api, a paid Gemini key,
# OpenRouter's paid models), separated by commas. Empty: none is ever used, not
# even as a fallback. A subscription is never switched to a billed API on its own.
AGENT_ALLOW_BILLING=

# Switches: each provider is on unless its PROVIDER_<NAME>_ENABLED is false
# (grafeno-agent providers disable <name> sets it). claude-code-local runs your
# own Claude Code with its own sign-in (claude login); using a Pro or Max
# subscription this way in a third-party orchestrator awaits clarification from
# Anthropic. It is on for now as a project setting, not an approval by Anthropic:
# false turns it off at once, without touching the other providers.
PROVIDER_CLAUDE_CODE_LOCAL_ENABLED=true
PROVIDER_CLAUDE_API_ENABLED=true
PROVIDER_CODEX_ENABLED=true
# Coding plans start off: their terms do not clearly allow a third-party agent.
# PROVIDER_KIMI_PLAN_ENABLED=true

# Keys of connections by key are kept in the system's secure store by
# grafeno-agent login <connection>; an environment variable works too:
# OPENAI_API_KEY, DEEPSEEK_API_KEY, MISTRAL_API_KEY, MOONSHOT_API_KEY,
# DASHSCOPE_API_KEY, ZAI_API_KEY, MINIMAX_API_KEY, XAI_API_KEY, and for coding
# plans KIMI_CODE_API_KEY, ZAI_CODING_API_KEY, MINIMAX_CODING_API_KEY,
# DASHSCOPE_CODING_API_KEY. Commands the agent runs never see them.
# A vendor with several documented endpoints takes <CONNECTION>_ENDPOINT
# (only those: moonshot global|china, qwen singapore|beijing, minimax global|china,
# xai global|us).
MOONSHOT_ENDPOINT=

# claude-api (the Claude Agent SDK with your Anthropic API key, billed per token):
# the most one turn may cost, in US dollars (the SDK's own estimate). Empty: none.
CLAUDE_API_MAX_BUDGET_USD=

# Web search (web_search): the service the agent searches with, when you want it
# to. Set one: a Brave Search API key, a Tavily API key, or the address of your
# own SearXNG (its json format allowed). With more than one, WEB_SEARCH chooses
# (brave, tavily or searxng). Each search asks you first; keys are never shown to
# the model nor to commands.
WEB_SEARCH=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
