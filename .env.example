# Copy to `.env` (ignored by git) and fill in. Real environment variables win.

# The Grafeno server.
GRAFENO_URL=http://127.0.0.1:7810

# The agent's own key, made by an administrator with `grafeno keys create`.
# Never commit it.
GRAFENO_AGENT_KEY=

# The namespace the agent keeps its memory in.
GRAFENO_NAMESPACE=grafeno-agent

# The model the agent reasons with. `claude-code` drives the locally
# logged-in Claude Code (the user's subscription, no API key).
AGENT_MODEL=claude-code

# For claude-code: the Claude model (haiku, sonnet, opus...). Empty: Claude
# Code's own default. It spends the same plan either way; lighter models
# spend less of it.
CLAUDE_MODEL=

# The project the agent works on: its memory lives in a palace of this name.
# Empty: the git repository (or folder) the agent runs in.
AGENT_PROJECT=

# Whose palace the project's memory goes in: shared (the project's own, used
# by every agent on it) or own (a palace of this agent alone, named
# "<project> · <agent>", for an agent that does not work with the others).
AGENT_PALACE=shared

# Meaning for memory: e5-small (a local model, downloaded once, about 130 MB,
# into ~/.cache/grafeno-agent/models) or none (words alone).
AGENT_EMBEDDER=e5-small

# The shell that runs commands: the program and its arguments. Empty: Git's
# bash on Windows when installed, else cmd; /bin/sh elsewhere.
AGENT_SHELL=
