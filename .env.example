# Copy to `.env` (ignored by git) and fill in. Real environment variables win.

# The Grafeno server.
GRAFENO_URL=http://127.0.0.1:7810

# The agent's own key, made by an administrator with `grafeno keys create`.
# Never commit it.
GRAFENO_AGENT_KEY=

# The namespace the agent keeps its memory in.
GRAFENO_NAMESPACE=grafeno-agent

# The model the agent reasons with. `claude-code` drives the locally
# logged-in Claude Code (the user's subscription, no API key).
AGENT_MODEL=claude-code

# For claude-code: the Claude model (haiku, sonnet, opus...). Empty: Claude
# Code's own default. It spends the same plan either way; lighter models
# spend less of it.
CLAUDE_MODEL=
