{
  "name": "grafeno-agent",
  "version": "0.0.0",
  "private": true,
  "description": "An agent with long-term memory, built on Grafeno",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "grafeno-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts startup",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsx src/cli.ts check",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:live:model": "vitest run --config vitest.live.config.ts model"
  },
  "dependencies": {
    "@grafenodb/client": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
