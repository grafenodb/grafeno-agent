{
  "name": "grafeno-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A programming assistant with long-term memory in Grafeno, reasoning with Claude through your own Claude Code",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "keywords": [
    "grafeno",
    "agent",
    "memory",
    "claude-code",
    "cli",
    "programming-assistant"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "grafeno-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts startup memory quality",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsx src/cli.ts check",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:live:model": "vitest run --config vitest.live.config.ts model",
    "chat": "tsx src/cli.ts chat",
    "upkeep": "tsx src/cli.ts upkeep",
    "measure:meaning": "tsx test/eval/measure-meaning.ts",
    "eval": "tsx test/eval/run-eval.ts",
    "eval:real": "tsx test/eval/run-eval.ts --model claude-code",
    "eval:agents": "tsx test/eval/agents.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@grafenodb/client": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
