{
  "name": "@grafenodb/agent-cli",
  "version": "0.1.5",
  "description": "CLI for autonomous AI coding agents with multi-agent orchestration, persistent graph memory powered by Grafeno, and intelligent model routing.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "keywords": [
    "grafeno",
    "agent",
    "ai-agent",
    "coding-agent",
    "multi-agent",
    "orchestration",
    "memory",
    "knowledge-graph",
    "model-routing",
    "claude-code",
    "codex",
    "cli"
  ],
  "homepage": "https://github.com/grafenodb/grafeno-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafenodb/grafeno-agent.git"
  },
  "bugs": {
    "url": "https://github.com/grafenodb/grafeno-agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.13"
  },
  "bin": {
    "grafeno-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts startup memory quality",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsx src/cli.ts check",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:live:model": "vitest run --config vitest.live.config.ts model",
    "chat": "tsx src/cli.ts chat",
    "upkeep": "tsx src/cli.ts upkeep",
    "measure:meaning": "tsx test/eval/measure-meaning.ts",
    "eval": "tsx test/eval/run-eval.ts",
    "eval:real": "tsx test/eval/run-eval.ts --model claude-code",
    "eval:agents": "tsx test/eval/agents.ts",
    "eval:orchestration": "tsx test/eval/orchestration.ts",
    "eval:routing": "tsx test/eval/routing-sim.ts",
    "preview:tui": "tsx test/live/preview-tui.tsx",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@grafenodb/client": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "0.8.2",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
